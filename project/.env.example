# ============================================================
# PROMPT-OPS: Closed-Loop Telemetry-Aware Prompt Optimization
# ============================================================
# Copy this file to .env and fill in your API key.

# ── OpenRouter API (REQUIRED) ──────────────────────────────
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-8b-instruct:free
OPENROUTER_JUDGE_MODEL=meta-llama/llama-3.3-8b-instruct:free

# ── Database Configuration ─────────────────────────────────
DATABASE_URL=sqlite:///data/prompt_ops.db

# ── Monitoring Configuration ───────────────────────────────
ENABLE_TELEMETRY=true

# ── Alert Thresholds ───────────────────────────────────────
LATENCY_THRESHOLD_MS=5000
ERROR_RATE_THRESHOLD=0.10
COST_THRESHOLD_USD=1.0

# ── Prompt Optimization Settings ──────────────────────────
AUTO_OPTIMIZE_ENABLED=true
MIN_SAMPLES_FOR_OPTIMIZATION=5

# ── Temperature Optimization ──────────────────────────────
TEMPERATURE_MIN=0.0
TEMPERATURE_MAX=1.5
TEMPERATURE_STEP=0.5
TEMPERATURE_TRIALS_PER_STEP=2

# ── Cost-Aware Routing ────────────────────────────────────
COST_ROUTING_ENABLED=true
QUALITY_THRESHOLD_FOR_DOWNGRADE=0.6

# ── LLM-as-Judge Evaluation ──────────────────────────────
AUTO_EVALUATE=true
EVALUATION_SAMPLE_RATE=1.0

# ── Closed-Loop Feedback ─────────────────────────────────
FEEDBACK_LOOP_ENABLED=true
AUTO_PROMOTE_THRESHOLD=0.15
AUTO_RETIRE_THRESHOLD=0.20

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
